# Конфиг прод-деплоя DankoDeploy (docker-compose). Скопируйте в deploy/.env.
# Секреты заполняет Ansible автоматически; вручную — см. README.

# Домен панели (A-запись → IP сервера). Traefik выпустит на него сертификат.
DANKODEPLOY_DOMAIN=panel.example.com

# Мастер-ключ AES-256-GCM (base64, 32 байта). БЕЗ него не расшифровать SSH-доступы!
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DANKODEPLOY_MASTER_KEY=

# scrypt-хэш пароля панели (формат "scrypt$N$salt$hash"). Аутентификация ОБЯЗАТЕЛЬНА (веб-терминал = shell).
# Сгенерировать: pnpm gen-password
# ВАЖНО: в этом .env compose трактует '$' как подстановку переменной — при ВСТАВКЕ ВРУЧНУЮ
# удвойте каждый '$' (scrypt$$N$$salt$$hash), иначе compose съест соль/хэш и вход не сработает.
DANKODEPLOY_AUTH_PASSWORD_HASH=

# Секрет подписи cookie сессии (hex). Постоянное значение — чтобы сессии переживали рестарт.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DANKODEPLOY_SESSION_SECRET=

# SHA-256 токена CLI. Сгенерировать: pnpm gen-token (сырой DANKODEPLOY_TOKEN хранить отдельно).
DANKODEPLOY_AUTOMATION_TOKEN_HASH=

# Commit, передаваемый запущенному backend-контейнеру. Ansible задаёт автоматически.
# При ручной сборке: export DANKODEPLOY_COMMIT=$(git rev-parse HEAD)
DANKODEPLOY_COMMIT=unknown
