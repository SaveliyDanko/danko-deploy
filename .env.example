# --- DankoDeploy server config ---

# Порт API-сервера
PORT=3001

# Адрес прослушивания. По умолчанию только localhost (наружу не торчит).
HOST=127.0.0.1

# Путь к файлу SQLite-базы
DATABASE_URL=./data/dankodeploy.sqlite

# Мастер-ключ для шифрования SSH-секретов (AES-256-GCM).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ВАЖНО: без этого ключа сохранённые SSH-доступы не расшифровать. Храните надёжно.
DANKODEPLOY_MASTER_KEY=

# Куда складывать бэкапы локально
BACKUP_DIR=./backups

# URL фронтенда (для CORS в dev)
WEB_ORIGIN=http://localhost:5173

# --- Аутентификация панели ---
# Хэш пароля (scrypt) для входа в панель. Если ПУСТО — аутентификация ВЫКЛЮЧЕНА
# (только для локальной разработки). ОБЯЗАТЕЛЬНО задайте перед выставлением наружу.
# Сгенерировать (выведет обе строки ниже): pnpm gen-password
DANKODEPLOY_AUTH_PASSWORD_HASH=

# Секрет для подписи cookie сессии. Если пусто — генерируется разовый при старте
# (сессии слетают при перезапуске). Для стабильных сессий задайте постоянное значение.
DANKODEPLOY_SESSION_SECRET=
