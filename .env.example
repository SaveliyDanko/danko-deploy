# --- DankoDeploy server config ---

# Порт API-сервера
PORT=3001

# Адрес прослушивания. По умолчанию только localhost (наружу не торчит).
# ВНИМАНИЕ: если HOST не петлевой (не 127.0.0.1/::1/localhost), а аутентификация
# выключена (нет DANKODEPLOY_AUTH_PASSWORD_HASH) — сервер ОТКАЖЕТСЯ стартовать
# (fail-closed: панель = shell ко всем серверам). Задайте пароль или DANKODEPLOY_ALLOW_NO_AUTH.
HOST=127.0.0.1

# Путь к файлу SQLite-базы
DATABASE_URL=./data/dankodeploy.sqlite

# Мастер-ключ для шифрования SSH-секретов (AES-256-GCM).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ВАЖНО: без этого ключа сохранённые SSH-доступы не расшифровать. Храните надёжно.
DANKODEPLOY_MASTER_KEY=

# Куда складывать бэкапы локально
BACKUP_DIR=./backups

# URL фронтенда (для CORS в dev)
WEB_ORIGIN=http://localhost:5173

# --- Аутентификация панели ---
# Хэш пароля (scrypt) для входа в панель. Если ПУСТО — аутентификация ВЫКЛЮЧЕНА
# (только для локальной разработки). ОБЯЗАТЕЛЬНО задайте перед выставлением наружу.
# Сгенерировать (выведет обе строки ниже): pnpm gen-password
DANKODEPLOY_AUTH_PASSWORD_HASH=

# Секрет для подписи cookie сессии. Если пусто — генерируется разовый при старте
# (сессии слетают при перезапуске). Для стабильных сессий задайте постоянное значение.
DANKODEPLOY_SESSION_SECRET=

# SHA-256 токена автоматизации для CLI (сам токен здесь НЕ хранится).
# Сгенерировать пару DANKODEPLOY_TOKEN + hash: pnpm gen-token
# Bearer-токен имеет ограниченный доступ: контекст и операции деплоя, без терминала/ключей/секретов.
DANKODEPLOY_AUTOMATION_TOKEN_HASH=

# Git commit запущенной сборки. В production его автоматически фиксирует Ansible.
DANKODEPLOY_COMMIT=

# Разрешить запуск на не-петлевом HOST с ВЫКЛЮЧЕННОЙ аутентификацией (обходит
# fail-closed-проверку). Только если панель за доверенным обратным прокси, который
# сам выполняет аутентификацию. Значения: true/1/yes. По умолчанию выключено.
DANKODEPLOY_ALLOW_NO_AUTH=

# Максимальный размер загружаемого файла (импорт конфигурации / файл бэкапа), в МБ.
# Предохранитель от заполнения диска одним запросом. По умолчанию 1024 (1 GiB),
# вровень с nginx client_max_body_size в проде.
DANKODEPLOY_MAX_UPLOAD_MB=1024
