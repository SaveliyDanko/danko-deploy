{
  "name": "dankodeploy",
  "version": "0.1.0",
  "private": true,
  "description": "Веб-панель для деплоя, мониторинга и бэкапов своих сервисов на VPS по SSH",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/**\" dev",
    "dev:server": "pnpm --filter @dankodeploy/server dev",
    "dev:web": "pnpm --filter @dankodeploy/web dev",
    "build": "pnpm -r build",
    "db:push": "pnpm --filter @dankodeploy/db push",
    "db:generate": "pnpm --filter @dankodeploy/db generate",
    "db:migrate": "pnpm --filter @dankodeploy/db migrate",
    "db:studio": "pnpm --filter @dankodeploy/db studio",
    "gen-password": "pnpm --filter @dankodeploy/server gen-password",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "pnpm audit --prod --audit-level high",
    "audit:all": "pnpm audit --audit-level low",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.5.1"
}
